{
  "name": "@velora/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Velora agent runtime — Alpha detection + Gamma critique + KeeperHub execution",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx watch src/index.ts",
    "simulate": "node dist/index.js --simulate",
    "audit": "node dist/index.js --audit",
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/openai": "^0.3.0",
    "@velora/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.0",
    "ethers": "^6.17.0",
    "langchain": "^0.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
