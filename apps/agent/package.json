{
  "name": "@keeperguard/agent",
  "version": "0.1.0",
  "private": true,
  "description": "KeeperGuard agent runtime — Alpha detection + Gamma critique + KeeperHub execution",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
