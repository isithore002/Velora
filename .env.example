# KeeperGuard Environment Variables

# KeeperHub
KEEPERHUB_API_KEY=kh_your_api_key_here
KEEPERHUB_ORG_ID=org_your_org_id_here

# OpenAI (for Gamma critique agent)
OPENAI_API_KEY=sk-your_openai_key_here

# Blockchain
ALCHEMY_API_KEY=your_alchemy_key_here
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# Wallet Config
MONITORED_WALLET=0xYourWalletAddress
COLD_WALLET=0xYourColdWalletAddress

# Agent Config
THRESHOLD=70
USE_REAL_POLLING=false
POLL_INTERVAL_MS=30000

# Dashboard
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
