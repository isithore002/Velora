# Velora Environment Variables

# KeeperHub
KEEPERHUB_API_KEY=kh_your_api_key_here
KEEPERHUB_ORG_ID=org_your_org_id_here

# Gemini (for Gamma critique agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Blockchain — Base Sepolia (testnet, fine for hackathon proof)
CHAIN_ID=84532
WSS_RPC_URL=wss://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Wallet Config
MONITORED_WALLET=0xYourWalletAddress
COLD_WALLET=0xYourColdWalletAddress

# Agent Config
THRESHOLD=70
POLL_INTERVAL_MS=30000

# Dashboard
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
